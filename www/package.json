{
  "name": "www",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:extension": "BUILD_TARGET=extension vue-tsc -b && BUILD_TARGET=extension vite build",
    "build:web": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "package:extension": "npm run build:extension && npm run copy:extension",
    "copy:extension": "cp manifest.json background.js dist/ && cp -r public/icons dist/",
    "serve": "npm run build:web && npm run preview"
  },
  "dependencies": {
    "@skeletonlabs/skeleton": "^3.2.2",
    "@skeletonlabs/tw-plugin": "^0.4.1",
    "@tailwindcss/postcss": "^4.1.14",
    "autoprefixer": "^10.4.21",
    "lucide-vue-next": "^0.545.0",
    "pinia": "^3.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.22",
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "sharp": "^0.34.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-static-copy": "^3.1.3",
    "vue-tsc": "^3.1.0"
  }
}
