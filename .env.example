# LightRAG Preprocessing API Configuration

# Application Configuration
DEBUG=false
HOST=0.0.0.0
PORT=8000

# LightRAG Configuration
LIGHTRAG_BASE_URL=http://localhost:8000
LIGHTRAG_API_KEY=your_lightrag_api_key
LIGHTRAG_TIMEOUT=30

# Vision Model Configuration (OpenRouter)
VISION_MODEL_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL_API_KEY=your_openrouter_api_key
VISION_MODEL_NAME=openai/gpt-4-vision-preview
VISION_MODEL_TIMEOUT=60
VISION_MODEL_MAX_TOKENS=1000

# Security Configuration
API_KEY=your_api_key_here
SECRET_KEY=your_secret_key_here

# File Upload Configuration
MAX_FILE_SIZE=52428800  # 50MB in bytes
MAX_IMAGE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=.pdf,.txt,.md,.docx
ALLOWED_IMAGE_TYPES=.jpg,.jpeg,.png,.webp

# YouTube Configuration
YOUTUBE_LANGUAGES=de,en
YOUTUBE_TIMEOUT=30

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=app.log  # Optional: specify log file path

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5